# Contact terminal mail (src/app/api/contact/route.ts).
# Set these on the host; without them the form falls back to the visitor's mail app.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=465
SMTP_USER=sender@your-domain.com
SMTP_PASS=
# Where briefs land (defaults to SMTP_USER)
CONTACT_TO=inbox@your-domain.com
# "off" stops the "transmission received" note to the visitor
CONTACT_CONFIRM=on
